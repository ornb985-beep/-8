# Apex vendor init (Android 12L on the Apex VMM). Replaces the emulator's
# init.ranchu.rc, which is not imported (androidboot.hardware != ranchu) and
# depends on QEMU goldfish devices; the device-independent parts are kept.
on early-init
    write /dev/kmsg "APEX: vendor mounted (cloud vendor), second stage init running"
    setprop dalvik.vm.dex2oat64.enabled 1
    # EGL/Vulkan drivers come from the boot configuration (VMM profile).
    # (early-init: SurfaceFlinger starts with class core at the end of `on boot`.)
    setprop ro.hardware.egl ${ro.boot.hardware.egl}
    setprop ro.hardware.vulkan ${ro.boot.hardware.vulkan}

on init
    # set RLIMIT_MEMLOCK to 8MB for BPF network statistics
    setrlimit memlock 8388608 8388608
    write /sys/block/zram0/comp_algorithm lz4
    write /proc/sys/vm/page-cluster 0
    # EAS uclamp groups
    mkdir /dev/cpuctl/foreground
    mkdir /dev/cpuctl/background
    mkdir /dev/cpuctl/top-app
    mkdir /dev/cpuctl/rt
    chown system system /dev/cpuctl
    chown system system /dev/cpuctl/foreground
    chown system system /dev/cpuctl/background
    chown system system /dev/cpuctl/top-app
    chown system system /dev/cpuctl/rt
    chown system system /dev/cpuctl/tasks
    chown system system /dev/cpuctl/foreground/tasks
    chown system system /dev/cpuctl/background/tasks
    chown system system /dev/cpuctl/top-app/tasks
    chown system system /dev/cpuctl/rt/tasks
    chmod 0664 /dev/cpuctl/tasks
    chmod 0664 /dev/cpuctl/foreground/tasks
    chmod 0664 /dev/cpuctl/background/tasks
    chmod 0664 /dev/cpuctl/top-app/tasks
    chmod 0664 /dev/cpuctl/rt/tasks

# /system is the root and /vendor was mounted by first-stage init; this
# mounts /data (formatted by fs_mgr on first boot: `formattable`).
on fs
    mount_all /vendor/etc/fstab.apex --early

on late-fs
    exec_start wait_for_keymaster
    mount_all /vendor/etc/fstab.apex --late

on post-fs-data
    setprop vold.post_fs_data_done 1
    mkdir /data/vendor/var 0755 root root
    mkdir /data/vendor/var/run 0755 root root

on boot
    setprop debug.hwui.renderer opengl
    setprop ro.zygote.disable_gl_preload 1
    chown root system /sys/power/wake_lock
    chown root system /sys/power/wake_unlock
    write /dev/kmsg "APEX: device ${ro.product.brand} ${ro.product.model} (${ro.product.name}/${ro.product.device}), hardware ${ro.hardware}, platform ${ro.board.platform}, SoC ${ro.soc.manufacturer} ${ro.soc.model}, GLES ${ro.opengles.version}, ABIs ${ro.product.cpu.abilist}"

on property:sys.boot_completed=1
    write /dev/kmsg "APEX: sys.boot_completed=1"

on property:init.svc.surfaceflinger=running
    write /dev/kmsg "APEX: surfaceflinger running"

on property:init.svc.keystore2=running
    write /dev/kmsg "APEX: keystore2 running"
